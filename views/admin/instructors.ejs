<%- include('../partials/head') %>
<h3>Instructors</h3>
<details open>
  <summary role="button" class="outline">Add instructor</summary>
  <form method="post" action="/admin/instructors"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid">
      <label>Name <input name="name" required></label>
      <label>Bio <input name="bio"></label>
    </div>
    <button>Add</button>
  </form>
</details>
<% for (const i of instructors) { %>
  <details>
    <summary><strong><%= i.name %></strong><%= i.active ? '' : ' · INACTIVE' %></summary>
    <form method="post" action="/admin/instructors/<%= i.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid">
        <label>Name <input name="name" value="<%= i.name %>" required></label>
        <label>Bio <input name="bio" value="<%= i.bio %>"></label>
      </div>
      <div class="grid">
        <button>Save</button>
        <button name="action" value="toggle" class="outline secondary"><%= i.active ? 'Deactivate' : 'Reactivate' %></button>
      </div>
    </form>
  </details>
<% } %>

<h3>Instructor logins</h3>
<p>Accounts that can sign in, see the classes assigned to them and check
   attendees in — no admin access. <a href="/admin/instructors/new" role="button" class="slim outline">Add instructor login</a></p>
<% if (accounts.length) { %>
<table>
  <thead><tr><th>Name</th><th>Email</th><th>Upcoming classes</th><th></th></tr></thead>
  <tbody>
  <% for (const a of accounts) { %>
    <tr>
      <td><%= a.name || '—' %></td>
      <td><%= a.email %></td>
      <td><%= a.upcoming_count %></td>
      <td><a href="/admin/instructors/<%= a.id %>/classes" role="button" class="slim outline">Assign classes</a></td>
    </tr>
  <% } %>
  </tbody>
</table>
<% } else { %>
  <p><em>No instructor logins yet.</em></p>
<% } %>
<%- include('../partials/foot') %>
