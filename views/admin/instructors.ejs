<%- include('../partials/head') %>
<h3>Instructors</h3>
<details open>
  <summary role="button" class="outline">Add instructor</summary>
  <form method="post" action="/admin/instructors"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid">
      <label>Name <input name="name" required></label>
      <label>Bio <input name="bio"></label>
    </div>
    <button>Add</button>
  </form>
</details>
<% for (const i of instructors) { %>
  <details>
    <summary><strong><%= i.name %></strong><%= i.active ? '' : ' · INACTIVE' %></summary>
    <form method="post" action="/admin/instructors/<%= i.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid">
        <label>Name <input name="name" value="<%= i.name %>" required></label>
        <label>Bio <input name="bio" value="<%= i.bio %>"></label>
      </div>
      <div class="grid">
        <button>Save</button>
        <button name="action" value="toggle" class="outline secondary"><%= i.active ? 'Deactivate' : 'Reactivate' %></button>
      </div>
    </form>
  </details>
<% } %>
<%- include('../partials/foot') %>
