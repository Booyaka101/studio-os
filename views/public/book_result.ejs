<%- include('../partials/head', { adminNav: false }) %>
<article>
  <% if (result.waitlisted) { %>
    <h2>You're on the waitlist</h2>
    <p><strong><%= inst.class_name %></strong> on <%= fmtDt(inst.starts_at) %> is currently full.
       You're #<%= waitlistPosition %> in line — if a spot opens we'll book you in automatically<%= smtpConfigured ? ' and email you' : '' %>.</p>
  <% } else { %>
    <h2>You're booked!</h2>
    <p><strong><%= inst.class_name %></strong> · <%= fmtDt(inst.starts_at) %></p>
    <p>Payment:
      <% if (result.booking.paid_with === 'pack') { const n = result.instance.credits_required ?? 1; %><%= n %> credit<%= n === 1 ? '' : 's' %> deducted from your class pack.
      <% } else if (result.booking.paid_with === 'membership') { %>covered by your membership.
      <% } else if (result.paymentId) { %>please pay <%= fmtMoney(inst.drop_in_price_cents) %> at the studio (cash/FPS) before class.
      <% } else { %>drop-in.
      <% } %>
    </p>
  <% } %>
  <% if (magicUrl) { %>
    <p>Manage or cancel your bookings any time:</p>
    <p><a href="<%= magicUrl %>" role="button" class="outline">My bookings</a></p>
    <p><small>Save that link — it's your personal booking manager (valid 7 days; you can request a new one from “My bookings” in the menu).</small></p>
  <% } else { %>
    <p>A confirmation email with a link to manage or cancel your booking is on its way.</p>
  <% } %>
</article>
<%- include('../partials/foot') %>
