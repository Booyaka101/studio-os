# Studio OS configuration. Copy to .env and edit. Everything is optional;
# the app runs fully offline with no env at all.

# Port for the HTTP server (default 3000)
#PORT=3000

# Path to the SQLite database (default data/studio.db)
#DB_PATH=data/studio.db

# Secret used to sign session cookies and magic-link tokens.
# Auto-generated and persisted in the settings table on first boot if unset.
#APP_SECRET=change-me

# Public base URL used in emails/magic links (default http://localhost:PORT)
#BASE_URL=https://booking.example.com

# --- SMTP (optional). When unset, emails are written to data/outbox/*.eml
# and magic links are shown on screen.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=user
#SMTP_PASS=pass
#SMTP_FROM="My Studio <noreply@example.com>"

# --- Stripe (optional, bring-your-own account). When unset, purchase flows
# fall back to "pay at studio" and manual activation.
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PUBLISHABLE_KEY=pk_test_...
